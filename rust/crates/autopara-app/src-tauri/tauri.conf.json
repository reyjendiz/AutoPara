{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoPara",
  "mainBinaryName": "AutoPara",
  "identifier": "com.autopara.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AutoPara",
        "width": 1240,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "AutoPara",
        "width": 380,
        "height": 520,
        "minWidth": 220,
        "minHeight": 48,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "publisher": "AutoPara",
    "copyright": "AutoPara",
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "template": "installer/installer.nsi",
        "installerHooks": "gen/installer-strings.nsh",
        "installMode": "currentUser",
        "languages": ["Ukrainian"],
        "installerIcon": "icons/icon.ico",
        "compression": "lzma"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZENTY4NDZFQjAxM0E4QzgKUldUSXFCT3dib1JXL2Uxd0IwSGx6eWxXcHhTZHpIVWpWTC8zQldyK3BvbW82V2JIOW9ybitHT0IK",
      "endpoints": [
        "https://github.com/reyjendiz/AutoPara/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
